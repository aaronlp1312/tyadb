#!/data/data/com.termux/files/usr/bin/bash
PID="$HOME/.local/state/tybridge.pid"
if [ -f "$PID" ]; then
  kill "$(cat "$PID")" 2>/dev/null || true
  rm -f "$PID"
  echo "[tybridge] stopped"
else
  pkill -f '[t]y-core' 2>/dev/null && echo "[tybridge] stopped (fallback)" || echo "[tybridge] not running"
fi
