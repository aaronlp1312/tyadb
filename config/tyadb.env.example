# ---- tyadb.env ------------------------------------------------------------
# Workspace compatibility copy. The canonical live file is ~/tyadb.env.
# Prefer the Tydroid adb wrapper if present, then the old custom path, then
# Termux/system adb.
TYDROID_ROOT="${TYDROID_ROOT:-${HOME}/tydroid}"
ADB_BIN="${ADB_BIN:-}"
[ -n "$ADB_BIN" ] || ADB_BIN="${TYDROID_ROOT}/bin/adb"
[ -x "$ADB_BIN" ] || ADB_BIN="${HOME}/lib/tyty/adb"
[ -x "$ADB_BIN" ] || ADB_BIN="$(command -v adb || true)"
[ -n "$ADB_BIN" ] || { echo "tyadb: no adb found; install android-tools"; exit 127; }

# Optional: pin a server port (leave empty to use default 5037)
ADB_SERVER_PORT=""

# Default wireless endpoint. Leave empty unless explicitly set by the user;
# stale :5555 endpoints should live in state, not in source config.
TYADB_DEFAULT_HOST="${TYADB_DEFAULT_HOST:-}"

# State
TYADB_STATE_DIR="${HOME}/.config/tyadb"
mkdir -p "$TYADB_STATE_DIR"
TYADB_LAST_HOST_FILE="$TYADB_STATE_DIR/last_host"
TYADB_LAST_SERIAL_FILE="$TYADB_STATE_DIR/last_serial"
TYADB_LAST_ENDPOINT_FILE="$TYADB_STATE_DIR/last_endpoint"

__tyrun() {
  if [ -n "$ADB_SERVER_PORT" ]; then ADB_SERVER_PORT="$ADB_SERVER_PORT" "$ADB_BIN" "$@"
  else                                 "$ADB_BIN" "$@"
  fi
}
